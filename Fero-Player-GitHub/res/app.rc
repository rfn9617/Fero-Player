#include <winver.h>
IDI_ICON1 ICON "fero.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Fero Player"
      VALUE "FileDescription", "Fero Player"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "FeroPlayer"
      VALUE "LegalCopyright", "Fero Player authors. GPL-3.0-or-later"
      VALUE "OriginalFilename", "FeroPlayer.exe"
      VALUE "ProductName", "Fero Player"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
